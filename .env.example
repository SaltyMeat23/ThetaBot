# --- ThetaBot secrets (copy to .env; never commit .env) ---

# Dashboard login (you choose these; used to open the web UI)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# Protects the control endpoints (pause/resume/config). Use a long random string.
CONTROL_TOKEN=change-me-long-random

# --- Optional integrations (leave blank to disable) ---
# Desktop/mobile push alerts (https://pushover.net)
PUSHOVER_TOKEN=
PUSHOVER_USER=
# AI trade-review commentary via Claude (optional; the bot trades fine without it)
ANTHROPIC_API_KEY=

# NOTE: this Robinhood-only edition needs NO market-data keys.
# Robinhood auth is a file (data/rh_oauth.json), not an env var — see README Step 1.
